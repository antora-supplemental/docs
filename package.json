{
  "name": "@antora-supplemental/docs",
  "private": true,
  "scripts": {
    "build": "antora antora-playbook.yml",
    "maint:orphans": "facto-maint orphan-finder --root ./docs --out ./build/orphan-finder",
    "maint:nav-drift": "facto-maint nav-drift --root ./docs --require-in-nav --out ./build/nav-drift",
    "maint:stale": "facto-maint stale-page --root ./docs --days 365 --out ./build/stale-page",
    "maint:pins": "facto-maint playbook-pin-auditor --root . --playbook antora-playbook.yml",
    "maint:deep-links": "facto-maint deep-link-contracts --config deep-link-contracts.yml --site-dir ./build/site"
  },
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "@antora-supplemental/incremental": "github:antora-supplemental/antora-incremental",
    "@antora-supplemental/instruction-flow": "file:../asciidoc-interactive"
  },
  "devDependencies": {
    "@antora-supplemental/facto-stack": "github:antora-supplemental/facto-stack#v0.2.48",
    "@antora-supplemental/serve": "file:../antora-serve",
    "antora": "^3.1.14"
  }
}
